  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uC88C\uCE21\uC758 \uD0ED\uC744 \uB20C\uB7EC\uC11C \uD398\uC774\uC9C0\uB97C
    \uC774\uB3D9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4! \uAC00\uC7A5 \uBA3C\uC800
    \uBF51\uAE30 \uD0ED\uC73C\uB85C \uC774\uB3D9\uD574\uC11C \uD0C0\uC6CC\uB97C \uBF51\uC544
    \uBCF4\uC138\uC694!\n\n\uD0C0\uC6CC\uB97C \uBF51\uC740 \uD6C4\uC5D0\uB294 \uD3B8\uC131
    \uD0ED\uC5D0\uC11C \uBF51\uC740 \uD0C0\uC6CC\uB97C \uD655\uC778\uD558\uACE0 \uC5B4\uB5A4
    \uD0C0\uC6CC\uB97C \uAC00\uC9C0\uACE0 \uAC8C\uC784\uC744 \uC9C4\uD589\uD560 \uC9C0
    \uC815\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4!\n\n\uD0C0\uC6CC \uC678\uC5D0\uB3C4
    \uB2E4\uC591\uD55C \uD6A8\uACFC\uB97C \uAC00\uC9C4 \uC720\uBB3C\uC744 \uBF51\uC744
    \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4!\n\n\uD0ED\uC5D0 \uB300\uD55C \uC124\uBA85\uC740
    \uBAA8\uB450 \uB05D\uB0AC\uC2B5\uB2C8\uB2E4. \uC774\uC81C \uB85C\uBE44\uB85C
    \uB3CC\uC544\uAC00\uC11C \uAC8C\uC784\uC744 \uC2DC\uC791\uD558\uC2DC\uC8E0. \n\n\uC544!
    \uAC8C\uC784\uC744 \uC2DC\uC791\uD558\uAE30 \uC804 \uD3B8\uC131 \uCC3D\uC5D0\uC11C
    \uD0C0\uC6CC\uB97C \uD3B8\uC131\uD558\uB294 \uAC83 \uC78A\uC9C0 \uB9C8\uC138\uC694!\n\n\n\n--\uC544\uBB34
    \uACF3\uC774\uB098 \uD074\uB9AD\uD574\uC11C \uD29C\uD1A0\uB9AC\uC5BC\uC744 \uC885\uB8CC\uD558\uC138\uC694.--"
  m_isRightToLeft: 0
